# Backend: mock (built-in demo data) or paas (Adobe Commerce 2.4.7+ with B2B)
COMMERCE_BACKEND=paas

# The company user the agent acts as. Never an admin.
COMMERCE_CALLER_EMAIL=buyer@company.example
COMMERCE_BASE_URL=https://store.example.com
# COMMERCE_STORE_CODE=default

# One of these two. A token is preferred (no password on disk).
COMMERCE_CUSTOMER_TOKEN=
# COMMERCE_CUSTOMER_PASSWORD=

# Signs write confirmation tokens. 32+ random characters, e.g. `openssl rand -hex 32`.
COMMERCE_CONFIRM_SECRET=

# Optional: least-privilege integration token for MSI salable qty and per-source stock.
# COMMERCE_INVENTORY_TOKEN=
# COMMERCE_STOCK_ID=1
# COMMERCE_SOURCE_LEAD_TIMES={"default":2}

# Optional: map fastener attributes to your attribute codes.
# COMMERCE_ATTRIBUTE_MAP={"thread":"thread_size","length_mm":"length","material":"material"}

# Optional
# COMMERCE_QUOTE_REVIEW_URL=https://store.example.com/negotiable_quote/quote/
# COMMERCE_TOOLS_DISABLED=draft_negotiable_quote
# COMMERCE_AUDIT_LOG=/var/log/commerce-b2b-mcp/audit.jsonl
