{
  "name": "commerce-b2b-mcp",
  "version": "0.4.0",
  "description": "MCP server that lets AI agents act as a B2B buyer or sales-rep assistant on Adobe Commerce (PaaS and ACCS), caller-scoped and safe by default.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "demo": "tsx src/index.ts demo",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "eval": "tsx src/assistant/eval/run.ts",
    "eval:golden": "tsx evals/generate.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "adobe-commerce",
    "magento",
    "b2b",
    "claude",
    "ai-agents"
  ],
  "author": "Sohel Rana",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "bin": {
    "commerce-b2b-mcp": "dist/index.js",
    "rfq-quote": "dist/assistant/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
